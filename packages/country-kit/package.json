{
  "name": "country-kit",
  "description": "Official ISO 3166-1 country data for TypeScript: codes, names, ITU-T E.164 calling codes, UN M49 regions, IANA TLDs, ISO 4217 currencies, and Wikipedia SVG flags.",
  "version": "2.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "import": "./dist/flags.js",
      "require": "./dist/flags.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/**", "README.md"],
  "keywords": [
    "country",
    "countries",
    "country-codes",
    "iso-codes",
    "country-data",
    "country-flags",
    "country-calling-codes",
    "flag-emoji",
    "country-list",
    "international",
    "iso-3166",
    "iso-3166-1",
    "e164",
    "un-m49",
    "svg-flags",
    "typescript",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thevipinmishra/country-kit.git",
    "directory": "packages/country-kit"
  },
  "homepage": "https://country-kit.vercel.app/",
  "scripts": {
    "generate": "node scripts/generate-data.mjs",
    "generate:flags": "node scripts/generate-flags.mjs",
    "build": "rslib build",
    "check": "biome check --write",
    "dev": "rslib build --watch",
    "format": "biome format --write",
    "publish": "pnpm run build && npm publish",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3",
    "@rslib/core": "^0.2.0",
    "@types/node": "^22.8.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "author": "Vipin Mishra",
  "license": "ISC"
}
