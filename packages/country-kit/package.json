{
  "name": "country-kit",
  "description": "ISO 3166-1 country data for TypeScript: alpha-2/3 codes, names, ITU-T E.164 calling codes, UN M49 regions, IANA ccTLDs, ISO 4217 currencies, flag emoji, and SVG flags.",
  "version": "2.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "import": "./dist/flags.js",
      "require": "./dist/flags.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "iso-3166",
    "iso-3166-1",
    "country",
    "countries",
    "country-codes",
    "country-list",
    "country-flags",
    "flag-emoji",
    "svg-flags",
    "calling-code",
    "e164",
    "phone",
    "dial-code",
    "iso-4217",
    "currency",
    "un-m49",
    "cctld",
    "locale",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thevipinmishra/country-kit.git",
    "directory": "packages/country-kit"
  },
  "bugs": {
    "url": "https://github.com/thevipinmishra/country-kit/issues"
  },
  "homepage": "https://country-kit.vercel.app/",
  "scripts": {
    "generate": "node scripts/generate-data.mjs",
    "generate:flags": "node scripts/generate-flags.mjs",
    "build": "rslib build",
    "check": "biome check --write",
    "dev": "rslib build --watch",
    "format": "biome format --write",
    "publish": "pnpm run build && npm publish",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Vipin Mishra",
  "license": "ISC"
}
