---
import { Code } from 'starlight-theme-nova/components';

interface Props {
  code: string;
  lang: 'bash' | 'typescript' | 'tsx' | 'vue';
  class?: string;
}

const { code, lang, class: className } = Astro.props;
---

<div class:list={['ck-code', className]}>
  <Code code={code} lang={lang} />
</div>
