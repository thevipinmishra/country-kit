---
import { TabItem, Tabs } from '@astrojs/starlight/components';
import { Code } from 'starlight-theme-nova/components';

interface Props {
  id: string;
  title: string;
  description: string;
  apis: string;
  reactCode: string;
  vueCode: string;
}

const { id, title, description, apis, reactCode, vueCode } = Astro.props;
---

<section class="example-block">
  <h2 id={id}>{title}</h2>
  <p>{description}</p>
  <p class="font-mono text-xs">{apis}</p>

  <div class="not-content">
    <Tabs syncKey="framework">
      <TabItem label="React">
        <div class="example-split">
          <div class="p-4 sm:p-5">
            <p class="mb-3 font-mono text-xs">Preview</p>
            <slot name="react" />
          </div>
          <Code code={reactCode} lang="tsx" />
        </div>
      </TabItem>
      <TabItem label="Vue">
        <div class="example-split">
          <div class="p-4 sm:p-5">
            <p class="mb-3 font-mono text-xs">Preview</p>
            <slot name="vue" />
          </div>
          <Code code={vueCode} lang="vue" />
        </div>
      </TabItem>
    </Tabs>
  </div>
</section>
