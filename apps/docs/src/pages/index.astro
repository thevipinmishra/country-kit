---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { LinkButton } from 'starlight-theme-nova/components';
import CodeBlock from '../components/CodeBlock.astro';

const samples = ['united', 'uk', 'Vietnam', '+1264', '840', '.uk', 'TRY', 'Paris'];

const install = `npm install country-kit`;
const usage = `import { getCountry, searchCountries } from 'country-kit';

const us = getCountry('US');
us?.commonName;           // 'United States'
us?.callingCode;          // '+1'
searchCountries('uk')[0]; // United Kingdom`;
---

<StarlightPage
  frontmatter={{
    title: 'Playground',
    description:
      'Search ISO 3166-1 countries by name, alias, calling code, TLD, or currency. Install country-kit for TypeScript.',
  }}
  headings={[{ depth: 2, slug: 'search', text: 'Search' }]}
>
  <p class="font-mono text-xs tracking-wide text-[var(--muted)]">npm · TypeScript · 249 codes</p>
  <p class="ck-lede mt-2">Look up ISO 3166-1 countries by code, name, TLD, or currency</p>
  <p class="mt-4 max-w-2xl text-[var(--muted)]">
    249 assigned ISO 3166-1 codes: ITU-T E.164 calling codes, UN M49 regions, IANA ccTLDs, ISO 4217 currencies, Unicode flags, and Wikipedia SVGs. No runtime dependencies.
  </p>
  <div class="not-content mt-6 flex flex-wrap gap-2">
    <LinkButton href="/getting-started/">Get started</LinkButton>
    <LinkButton href="/examples/" variant="secondary">Examples</LinkButton>
    <LinkButton href="/api/" variant="secondary">API</LinkButton>
  </div>
  <div class="mt-8 grid min-w-0 gap-4 lg:grid-cols-2">
    <div class="min-w-0">
      <p class="text-sm font-medium">Install</p>
      <CodeBlock class="mt-2" code={install} lang="bash" />
    </div>
    <div class="min-w-0">
      <p class="text-sm font-medium">Usage</p>
      <CodeBlock class="mt-2" code={usage} lang="typescript" />
    </div>
  </div>

  <h2 id="search">Search</h2>
  <p class="max-w-2xl text-sm text-[var(--muted)]">
    ISO short names, common names, aliases, alpha-2/3, numeric codes, dial prefixes, TLDs, currencies, capitals.
  </p>
  <p class="font-mono text-xs text-[var(--muted)]">searchCountries(query)</p>

  <div class="not-content mb-4 flex flex-wrap items-center gap-2" id="chips">
    {samples.map((sample) => (
      <button type="button" data-q={sample} class="ck-chip">
        {sample}
      </button>
    ))}
  </div>

  <div class="not-content grid min-w-0 gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="ck-panel p-4 lg:p-5">
      <label for="q" class="ck-label">Query</label>
      <input
        id="q"
        type="search"
        value="united"
        autocomplete="off"
        placeholder="UK, Vietnam, +1, 840, .uk, TRY, Paris"
        class="ck-field"
      />
      <p id="search-status" class="tabular mt-2 text-xs text-[var(--muted)]" role="status"></p>
      <ul id="results" class="mt-2 divide-y divide-[var(--line)]"></ul>
    </div>
    <aside id="detail" class="ck-panel p-5" aria-live="polite"></aside>
  </div>
</StarlightPage>

<script>
  import {
    getFlagSvgUrl,
    searchCountries,
    type Country,
  } from 'country-kit';

  const input = document.querySelector<HTMLInputElement>('#q');
  const list = document.querySelector<HTMLUListElement>('#results');
  const detail = document.querySelector<HTMLElement>('#detail');
  const chips = document.querySelector('#chips');
  const status = document.querySelector('#search-status');

  function escapeHtml(value: string) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function renderDetail(country: Country) {
    if (!detail) return;
    const url = getFlagSvgUrl(country.code) ?? '';
    detail.innerHTML = `
      <div class="flag-frame aspect-[4/3] w-full">
        <img src="${url}" alt="Flag of ${escapeHtml(country.commonName)}" />
      </div>
      <p class="mt-4 font-mono text-xs text-[var(--muted)]">${country.code} · ${country.alpha3} · ${country.numeric}</p>
      <h3 class="mt-1 text-lg font-semibold">${escapeHtml(country.commonName)}</h3>
      <p class="text-sm text-[var(--muted)]">${escapeHtml(country.name)}</p>
      <dl class="mt-4 grid grid-cols-2 gap-x-3 gap-y-2 text-sm">
        <dt class="text-[var(--muted)]">Calling</dt><dd class="tabular font-mono">${country.callingCode}</dd>
        <dt class="text-[var(--muted)]">Dial prefix</dt><dd class="tabular font-mono">${country.dialCode}</dd>
        <dt class="text-[var(--muted)]">TLD</dt><dd class="font-mono">${country.tld ?? '-'}</dd>
        <dt class="text-[var(--muted)]">Capital</dt><dd>${escapeHtml(country.capital ?? '-')}</dd>
        <dt class="text-[var(--muted)]">Currency</dt><dd class="font-mono">${country.currencies.join(', ') || '-'}</dd>
        <dt class="text-[var(--muted)]">Region</dt><dd>${escapeHtml(country.region ?? '-')}</dd>
        <dt class="text-[var(--muted)]">Independent</dt><dd>${country.independent ? 'yes' : 'territory'}</dd>
        <dt class="text-[var(--muted)]">Subregion</dt><dd>${escapeHtml(country.subregion ?? '-')}</dd>
      </dl>
    `;
  }

  function render(query: string) {
    if (!list) return;
    const matches = searchCountries(query, { limit: 8 });
    if (status) {
      status.textContent = matches.length
        ? `${matches.length} shown`
        : '0 shown';
    }
    if (!matches.length) {
      const q = escapeHtml(query.trim() || 'that query');
      list.innerHTML = `<li class="ck-empty">No countries match "${q}". Try an ISO code, calling prefix, TLD, or currency, or <button type="button" data-q="united" class="underline underline-offset-4">search united</button>.</li>`;
      if (detail) {
        detail.innerHTML = `<p class="ck-empty">Pick a sample above, or type a name, code, or TLD.</p>`;
      }
      return;
    }
    list.innerHTML = matches
      .map((country, index) => {
        const url = getFlagSvgUrl(country.code) ?? '';
        return `<li>
          <button type="button" data-index="${index}" class="ck-result">
            <span class="flag-frame h-6 w-8 shrink-0"><img src="${url}" alt="" /></span>
            <span class="min-w-0 flex-1">
              <span class="block truncate font-medium">${escapeHtml(country.commonName)}</span>
              <span class="block font-mono text-xs text-[var(--muted)]">${country.code} · ${country.dialCode}</span>
            </span>
            <span>${country.flag}</span>
          </button>
        </li>`;
      })
      .join('');

    list.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
      button.addEventListener('click', () => {
        const country = matches[Number(button.dataset.index)];
        if (country) renderDetail(country);
      });
    });

    renderDetail(matches[0]);
  }

  chips?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest('button[data-q]');
    const value = button?.getAttribute('data-q');
    if (!value || !input) return;
    input.value = value;
    input.focus();
    render(value);
  });

  list?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const sample = target?.closest('button[data-q]');
    const value = sample?.getAttribute('data-q');
    if (!value || !input) return;
    input.value = value;
    input.focus();
    render(value);
  });

  input?.addEventListener('input', () => render(input.value));
  render(input?.value ?? 'united');
</script>
