---
import Layout from '../layouts/Layout.astro';
import { Code } from 'astro:components';

const samples = ['united', 'uk', 'Vietnam', '+1264', '840', '.uk', 'TRY', 'Paris'];
---

<Layout title="Playground" description="Search country-kit: ISO names, aliases, codes, calling prefixes, TLDs, and currencies.">
  <section class="border-b border-[var(--line)]">
    <div class="container py-10 lg:py-14">
      <h1 class="text-3xl font-semibold tracking-tight lg:text-4xl">country-kit</h1>
      <p class="mt-3 max-w-2xl text-[var(--muted)]">
        ISO 3166-1 country data for TypeScript. 249 assigned codes, ITU-T E.164 calling codes, UN M49 regions, IANA ccTLDs, ISO 4217 currencies, and SVG flags. No runtime dependencies.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href="/examples" class="rounded-md bg-[var(--ink)] px-4 py-2 text-sm font-medium text-[var(--paper)] hover:bg-black">Examples</a>
        <a href="/explorer" class="rounded-md border border-[var(--ink)]/20 px-4 py-2 text-sm font-medium hover:border-[var(--ink)]">Explorer</a>
        <a href="/api" class="rounded-md border border-[var(--ink)]/20 px-4 py-2 text-sm font-medium hover:border-[var(--ink)]">API</a>
      </div>
      <div class="mt-6 max-w-xl min-w-0">
        <div class="ck-code">
          <Code code={`npm install country-kit`} lang="bash" theme="vesper" />
        </div>
      </div>
    </div>
  </section>

  <section class="container py-10">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-xl font-semibold">Search</h2>
        <p class="mt-1 text-sm text-[var(--muted)]">
          Names, aliases, alpha-2/3, numeric codes, dial prefixes, TLDs, currencies, capitals.
        </p>
      </div>
      <p class="font-mono text-xs text-[var(--muted)]">searchCountries(query)</p>
    </div>

    <div class="mb-4 flex flex-wrap gap-2" id="chips">
      {samples.map((sample) => (
        <button
          type="button"
          data-q={sample}
          class="rounded-md border border-[var(--line)] bg-white px-2.5 py-1 text-sm hover:border-[var(--ink)]"
        >
          {sample}
        </button>
      ))}
    </div>

    <div class="grid min-w-0 gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="min-w-0 rounded-lg border border-[var(--line)] bg-[var(--card)] p-4 lg:p-5">
        <label for="q" class="mb-2 block text-sm font-medium">Query</label>
        <input
          id="q"
          type="search"
          value="united"
          autocomplete="off"
          placeholder="UK, Vietnam, +1, 840, .uk, TRY, Paris…"
          class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2.5 outline-none ring-[var(--accent)] focus:ring-2"
        />
        <ul id="results" class="mt-4 divide-y divide-[var(--line)]"></ul>
      </div>
      <aside id="detail" class="min-w-0 rounded-lg border border-[var(--line)] bg-[var(--card)] p-5"></aside>
    </div>
  </section>
</Layout>

<script>
  import {
    getFlagSvgUrl,
    searchCountries,
    type Country,
  } from 'country-kit';

  const input = document.querySelector<HTMLInputElement>('#q');
  const list = document.querySelector<HTMLUListElement>('#results');
  const detail = document.querySelector<HTMLElement>('#detail');
  const chips = document.querySelector('#chips');

  function renderDetail(country: Country) {
    if (!detail) return;
    const url = getFlagSvgUrl(country.code) ?? '';
    detail.innerHTML = `
      <div class="flag-frame aspect-[4/3] w-full">
        <img src="${url}" alt="Flag of ${country.commonName}" />
      </div>
      <p class="mt-4 font-mono text-xs text-[var(--muted)]">${country.code} · ${country.alpha3} · ${country.numeric}</p>
      <h3 class="mt-1 text-lg font-semibold">${country.commonName}</h3>
      <p class="text-sm text-[var(--muted)]">${country.name}</p>
      <dl class="mt-4 grid grid-cols-2 gap-x-3 gap-y-2 text-sm">
        <dt class="text-[var(--muted)]">Calling</dt><dd class="font-mono">${country.callingCode}</dd>
        <dt class="text-[var(--muted)]">Dial prefix</dt><dd class="font-mono">${country.dialCode}</dd>
        <dt class="text-[var(--muted)]">TLD</dt><dd class="font-mono">${country.tld ?? '—'}</dd>
        <dt class="text-[var(--muted)]">Capital</dt><dd>${country.capital ?? '—'}</dd>
        <dt class="text-[var(--muted)]">Currency</dt><dd class="font-mono">${country.currencies.join(', ') || '—'}</dd>
        <dt class="text-[var(--muted)]">Region</dt><dd>${country.region ?? '—'}</dd>
        <dt class="text-[var(--muted)]">Independent</dt><dd>${country.independent ? 'yes' : 'territory'}</dd>
        <dt class="text-[var(--muted)]">Subregion</dt><dd>${country.subregion ?? '—'}</dd>
      </dl>
    `;
  }

  function render(query: string) {
    if (!list) return;
    const matches = searchCountries(query, { limit: 8 });
    if (!matches.length) {
      list.innerHTML = '<li class="px-1 py-6 text-sm text-[var(--muted)]">No matches.</li>';
      if (detail) detail.innerHTML = '<p class="text-sm text-[var(--muted)]">No matches.</p>';
      return;
    }
    list.innerHTML = matches
      .map((country, index) => {
        const url = getFlagSvgUrl(country.code) ?? '';
        return `<li>
          <button type="button" data-index="${index}" class="flex w-full items-center gap-3 px-1 py-3 text-left hover:bg-stone-50">
            <span class="flag-frame h-6 w-8 shrink-0"><img src="${url}" alt="" /></span>
            <span class="min-w-0 flex-1">
              <span class="block truncate font-medium">${country.commonName}</span>
              <span class="block font-mono text-xs text-[var(--muted)]">${country.code} · ${country.dialCode}</span>
            </span>
            <span>${country.flag}</span>
          </button>
        </li>`;
      })
      .join('');

    list.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
      button.addEventListener('click', () => {
        const country = matches[Number(button.dataset.index)];
        if (country) renderDetail(country);
      });
    });

    renderDetail(matches[0]);
  }

  chips?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest('button[data-q]');
    const value = button?.getAttribute('data-q');
    if (!value || !input) return;
    input.value = value;
    input.focus();
    render(value);
  });

  input?.addEventListener('input', () => render(input.value));
  render(input?.value ?? 'united');
</script>
