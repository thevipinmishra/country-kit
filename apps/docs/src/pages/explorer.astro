---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getAllCountries, getFlagSvgUrl, listRegions } from 'country-kit';

const countries = getAllCountries({ sortBy: 'commonName' }).map((country) => ({
  code: country.code,
  commonName: country.commonName,
  name: country.name,
  alpha3: country.alpha3,
  numeric: country.numeric,
  dialCode: country.dialCode,
  callingCode: country.callingCode,
  tld: country.tld,
  capital: country.capital,
  currencies: country.currencies,
  region: country.region,
  subregion: country.subregion,
  independent: country.independent,
  flag: country.flag,
  flagSvgUrl: getFlagSvgUrl(country.code) ?? '',
}));
const regions = listRegions();
---

<StarlightPage
  frontmatter={{
    title: 'Explorer',
    description:
      'Browse all 249 ISO 3166-1 countries and territories in country-kit. Filter by UN M49 region, independence, name, TLD, or currency.',
    tableOfContents: false,
  }}
>
  <p class="max-w-2xl text-[var(--muted)]">
    All 249 assigned ISO 3166-1 codes. Filter by UN M49 region or independent status.
  </p>

  <div class="not-content ck-filters">
    <div>
      <label for="filter-q" class="ck-label">Filter</label>
      <input
        id="filter-q"
        type="search"
        placeholder="Japan, JP, .jp, JPY, Tokyo"
        class="ck-field"
      />
    </div>
    <div>
      <label for="filter-region" class="ck-label">Region</label>
      <select id="filter-region" class="ck-select">
        <option value="">All regions</option>
        {regions.map((region) => <option value={region}>{region}</option>)}
      </select>
    </div>
    <div>
      <label for="filter-ind" class="ck-label">Status</label>
      <select id="filter-ind" class="ck-select">
        <option value="">Independent and territories</option>
        <option value="yes">Independent only</option>
        <option value="no">Territories only</option>
      </select>
    </div>
  </div>
  <p id="count" class="tabular mt-3 font-mono text-xs text-[var(--muted)]" role="status"></p>

  <div class="not-content ck-panel mt-4 min-w-0 overflow-x-auto">
    <table class="min-w-[44rem] text-left text-sm">
      <caption class="sr-only">ISO 3166-1 countries and territories</caption>
      <thead class="ck-table-head border-b border-[var(--line)] font-medium">
        <tr>
          <th class="px-4 py-3" scope="col">Flag</th>
          <th class="px-4 py-3" scope="col">Country</th>
          <th class="px-4 py-3" scope="col">Codes</th>
          <th class="px-4 py-3" scope="col">Dial</th>
          <th class="px-4 py-3" scope="col">TLD</th>
          <th class="px-4 py-3" scope="col">Currency</th>
          <th class="px-4 py-3" scope="col">Capital</th>
          <th class="px-4 py-3" scope="col">Region</th>
        </tr>
      </thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
</StarlightPage>

<script define:vars={{ countries }}>
  const q = document.querySelector('#filter-q');
  const region = document.querySelector('#filter-region');
  const ind = document.querySelector('#filter-ind');
  const rows = document.querySelector('#rows');
  const count = document.querySelector('#count');

  function escapeHtml(value) {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function apply() {
    const query = (q?.value || '').trim().toLowerCase();
    const regionValue = region?.value || '';
    const indValue = ind?.value || '';
    const matches = countries.filter((country) => {
      if (regionValue && country.region !== regionValue) return false;
      if (indValue === 'yes' && !country.independent) return false;
      if (indValue === 'no' && country.independent) return false;
      if (!query) return true;
      const hay = [
        country.commonName,
        country.name,
        country.code,
        country.alpha3,
        country.numeric,
        country.capital,
        country.tld,
        country.dialCode,
        country.callingCode,
        ...(country.currencies ?? []),
      ]
        .filter(Boolean)
        .join(' ')
        .toLowerCase();
      return hay.includes(query);
    });

    if (count) count.textContent = `${matches.length} shown`;
    if (!rows) return;
    if (!matches.length) {
      rows.innerHTML = `<tr><td colspan="8" class="px-4 py-8 text-sm text-[var(--muted)]">No countries match these filters. Clear the search or choose All regions.</td></tr>`;
      return;
    }
    rows.innerHTML = matches
      .map(
        (country) => `<tr class="border-b border-[var(--line)] last:border-0">
          <td class="px-4 py-2"><span class="flag-frame inline-block h-5 w-7 align-middle"><img src="${country.flagSvgUrl}" alt=""></span></td>
          <td class="px-4 py-2"><div class="font-medium">${escapeHtml(country.commonName)}</div><div class="text-xs text-[var(--muted)]">${escapeHtml(country.name)}</div></td>
          <td class="px-4 py-2 font-mono text-xs">${country.code} · ${country.alpha3} · ${country.numeric}</td>
          <td class="px-4 py-2 tabular font-mono text-xs">${country.dialCode}</td>
          <td class="px-4 py-2 font-mono text-xs">${country.tld ?? '-'}</td>
          <td class="px-4 py-2 font-mono text-xs">${country.currencies?.join(' ') || '-'}</td>
          <td class="px-4 py-2">${escapeHtml(country.capital ?? '-')}</td>
          <td class="px-4 py-2 text-xs">${escapeHtml(country.region ?? '-')}<div class="text-[var(--muted)]">${escapeHtml(country.subregion ?? '')}</div></td>
        </tr>`,
      )
      .join('');
  }

  q?.addEventListener('input', apply);
  region?.addEventListener('change', apply);
  ind?.addEventListener('change', apply);
  apply();
</script>
