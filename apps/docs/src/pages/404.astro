---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found"
  description="This page is not on the country-kit docs site. Open the playground, API, or examples."
>
  <section class="container max-w-xl py-16">
    <p class="font-mono text-xs text-[var(--muted)]">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 text-[var(--muted)]">
      That URL is not a docs page. Search countries from the playground, open the API, or read the changelog.
    </p>
    <div class="mt-6 flex flex-wrap gap-2">
      <a href="/" class="ck-btn rounded-md bg-[var(--ink)] px-4 py-2.5 text-sm font-medium text-[var(--paper)] hover:bg-black">Open playground</a>
      <a href="/api" class="ck-btn rounded-md border border-[var(--ink)]/20 px-4 py-2.5 text-sm font-medium hover:border-[var(--ink)]">API reference</a>
      <a href="/examples" class="ck-btn rounded-md border border-[var(--ink)]/20 px-4 py-2.5 text-sm font-medium hover:border-[var(--ink)]">Examples</a>
    </div>
  </section>
</Layout>
