---
import Layout from '../layouts/Layout.astro';
import ExampleBlock from '../components/ExampleBlock.astro';
import { snippets } from '../examples/snippets';
import ResidenceSelectReact from '../components/react/ResidenceSelect';
import PhoneFieldReact from '../components/react/PhoneField';
import CountryTypeaheadReact from '../components/react/CountryTypeahead';
import ProfileFlagReact from '../components/react/ProfileFlag';
import HostLookupReact from '../components/react/HostLookup';
import CodeValidatorReact from '../components/react/CodeValidator';
import ResidenceSelectVue from '../components/vue/ResidenceSelect.vue';
import PhoneFieldVue from '../components/vue/PhoneField.vue';
import CountryTypeaheadVue from '../components/vue/CountryTypeahead.vue';
import ProfileFlagVue from '../components/vue/ProfileFlag.vue';
import HostLookupVue from '../components/vue/HostLookup.vue';
import CodeValidatorVue from '../components/vue/CodeValidator.vue';

const toc = [
  ['#residence', 'Residence'],
  ['#phone', 'Phone'],
  ['#search', 'Ship-to'],
  ['#profile', 'Flags'],
  ['#tld', 'Hostname'],
  ['#validate', 'Validate'],
];
---

<Layout
  title="Examples"
  description="React and Vue examples for country-kit: signup selects, phone pickers, address search, SVG flags, TLD lookup, and ISO validation."
>
  <section class="ck-grid-bg border-b border-[var(--line)]">
    <div class="container py-12 lg:py-16">
      <p class="mb-3 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-[var(--accent)]">
        React · Vue islands
      </p>
      <h1 class="max-w-3xl text-4xl font-semibold leading-tight lg:text-5xl">
        Examples you can paste into a form.
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-[var(--muted)]">
        Each block is a product surface with a live React island, a live Vue island, and the snippet beside it. Switch tabs to compare.
      </p>
      <nav class="mt-8 flex flex-wrap gap-2">
        {toc.map(([href, label]) => (
          <a
            href={href}
            class="rounded-full border border-[var(--line)] bg-[var(--card)] px-3 py-1.5 text-sm hover:border-[var(--ink)]"
          >
            {label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <div class="container space-y-20 py-12 sm:py-16">
    <ExampleBlock
      id="residence"
      kicker="Signup / KYC"
      title="Country of residence"
      description="Independent-country dropdown. Persist the ISO alpha-2 code; show the common name. Territories stay out via independent: true."
      apis="getCountrySelectOptions · getCountry"
      reactCode={snippets.residence.react}
      vueCode={snippets.residence.vue}
    >
      <div slot="react">
        <ResidenceSelectReact client:idle />
      </div>
      <div slot="vue">
        <ResidenceSelectVue client:idle />
      </div>
    </ExampleBlock>

    <ExampleBlock
      id="phone"
      kicker="Checkout / 2FA"
      title="Phone number with dial prefix"
      description="Show dialCode in the picker (+1264 for Anguilla). Keep callingCode when you need the official E.164 country code (+1 for every NANP member)."
      apis="searchCountries · getDialCode · getCallingCode"
      reactCode={snippets.phone.react}
      vueCode={snippets.phone.vue}
    >
      <div slot="react">
        <PhoneFieldReact client:idle />
      </div>
      <div slot="vue">
        <PhoneFieldVue client:idle />
      </div>
    </ExampleBlock>

    <ExampleBlock
      id="search"
      kicker="Address / shipping"
      title="Typeahead country field"
      description="Ranked search over official names, common names, aliases (UK, Vietnam), codes, TLDs, currencies, and capitals."
      apis="searchCountries"
      reactCode={snippets.search.react}
      vueCode={snippets.search.vue}
    >
      <div slot="react">
        <CountryTypeaheadReact client:idle />
      </div>
      <div slot="vue">
        <CountryTypeaheadVue client:idle />
      </div>
    </ExampleBlock>

    <ExampleBlock
      id="profile"
      kicker="Profile / locale"
      title="Flag on a user card"
      description="CDN Wikipedia SVGs stay in the tiny core bundle. Import country-kit/flags only when you need offline inline markup."
      apis="getFlagSvgUrl · getCountryFlag · getCountry"
      reactCode={snippets.flag.react}
      vueCode={snippets.flag.vue}
    >
      <div slot="react">
        <ProfileFlagReact client:idle />
      </div>
      <div slot="vue">
        <ProfileFlagVue client:idle />
      </div>
    </ExampleBlock>

    <ExampleBlock
      id="tld"
      kicker="Growth / support"
      title="Country from a hostname or email"
      description="IANA ccTLDs map to ISO alpha-2 except the UK: gov.uk is GB, not .gb. Generic TLDs like .com are not countries."
      apis="getCountryByTld"
      reactCode={snippets.tld.react}
      vueCode={snippets.tld.vue}
    >
      <div slot="react">
        <HostLookupReact client:idle />
      </div>
      <div slot="vue">
        <HostLookupVue client:idle />
      </div>
    </ExampleBlock>

    <ExampleBlock
      id="validate"
      kicker="API / webhooks"
      title="Validate a country code"
      description="isValidCountryCode is a type guard for assigned alpha-2 codes. getCountry also accepts alpha-3 and UN numeric. Kosovo XK is rejected on purpose."
      apis="isValidCountryCode · getCountry · isValidCallingCode"
      reactCode={snippets.validate.react}
      vueCode={snippets.validate.vue}
    >
      <div slot="react">
        <CodeValidatorReact client:idle />
      </div>
      <div slot="vue">
        <CodeValidatorVue client:idle />
      </div>
    </ExampleBlock>
  </div>
</Layout>
