---
import Layout from '../layouts/Layout.astro';
import { Code } from 'astro:components';

const groups = [
  {
    title: 'Lookup',
    items: [
      ['getCountry(id)', 'Alpha-2, alpha-3, or numeric (`US`, `USA`, `840`).'],
      ['getCountryByCode(code)', 'ISO 3166-1 alpha-2 only.'],
      ['getCountryByAlpha3(alpha3)', 'ISO 3166-1 alpha-3.'],
      ['getCountryByNumeric(numeric)', 'UN M49 / ISO numeric; `"84"` pads to `"084"`.'],
      ['getCountryByTld(tld)', 'IANA ccTLD. `".uk"` and `"uk"` both resolve to GB.'],
      ['getCountryName(code)', 'Official ISO English short name.'],
      ['getCountryCommonName(code)', 'Everyday label (`United States`).'],
      ['getAlpha3Code / getNumericCode', 'Code conversions from alpha-2.'],
      ['getCallingCode(code)', 'ITU-T E.164 country code (`AI` → `+1`).'],
      ['getDialCode(code)', 'Phone-input prefix (`AI` → `+1264`).'],
      ['getCountryTld / Capital / Currencies', 'IANA TLD, capital, ISO 4217 codes.'],
      ['getCountryFlag(code)', 'Unicode regional-indicator emoji.'],
      ['getFlagSvgUrl(code, options?)', 'Version-pinned Wikipedia SVG URL (`4x3` or `1x1`).'],
    ],
  },
  {
    title: 'Lists and search',
    items: [
      ['getAllCountries(options?)', 'Filter by region, subregion, independent; sort by name/code/dial.'],
      ['getIndependentCountries()', 'ISO independent = yes (195).'],
      ['getCountrySelectOptions()', 'Ready-made select options with SVG URL and dial prefix.'],
      ['searchCountries(query, options?)', 'Ranked search over official names, common names, aliases, codes, TLDs, currencies, and capitals.'],
      ['getCountriesByCallingCode(code)', 'E.164 match; `+1264` resolves NANP NPAs.'],
      ['getCountriesByCurrency(code)', 'ISO 4217 alphabetic code (`EUR`, `usd`).'],
      ['getCountriesByRegion / Subregion', 'UN M49 grouping.'],
      ['listRegions / listSubregions / listCurrencies', 'Distinct region names and currency codes.'],
    ],
  },
  {
    title: 'Validation',
    items: [
      ['isValidCountryCode(code)', 'Type guard for assigned alpha-2 codes.'],
      ['isValidCallingCode(code)', 'E.164 format: `+` and 1–3 digits.'],
    ],
  },
];
---

<Layout title="API" description="Complete country-kit API: lookups, search, flags, calling codes, TLDs, currencies, and types.">
  <section class="container py-12">
    <h1 class="text-4xl font-bold tracking-tight">API reference</h1>
    <p class="mt-3 max-w-2xl text-[var(--muted)]">
      The core package stays small. Import <code class="font-mono text-sm">country-kit/flags</code> only when you need inline SVG markup.
    </p>

    <div class="mt-8 rounded-2xl border border-[var(--line)] bg-[var(--card)] p-5">
      <Code
        code={`import { getCountry, getFlagSvgUrl, searchCountries } from 'country-kit';
import { getFlagSvg } from 'country-kit/flags';

const japan = getCountry('JP');
getFlagSvgUrl('JP');     // CDN SVG
getFlagSvg('JP');        // inline <svg>…</svg>
searchCountries('uk');   // United Kingdom
searchCountries('.uk');  // same, via IANA TLD`}
        lang="typescript"
        theme="vesper"
      />
    </div>

    {groups.map((group) => (
      <div class="mt-12">
        <h2 class="text-2xl font-bold">{group.title}</h2>
        <div class="mt-4 overflow-hidden rounded-2xl border border-[var(--line)] bg-[var(--card)]">
          <table class="w-full text-left text-sm">
            <tbody>
              {group.items.map(([name, detail]) => (
                <tr class="border-b border-[var(--line)] last:border-0">
                  <th class="w-[40%] px-4 py-3 align-top font-mono text-xs font-medium">{name}</th>
                  <td class="px-4 py-3 text-[var(--muted)]">{detail}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}

    <h2 class="mt-12 text-2xl font-bold">Recipes</h2>
    <div class="mt-4 grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-[var(--line)] bg-[var(--card)] p-5">
        <h3 class="font-bold">Independent-country select</h3>
        <div class="mt-3">
          <Code
            code={`import { getCountrySelectOptions } from 'country-kit';

const options = getCountrySelectOptions({ independent: true });
// { value: 'FR', label: '🇫🇷 France', dialCode: '+33',
//   flag: '🇫🇷', flagSvgUrl: 'https://…/fr.svg' }`}
            lang="typescript"
            theme="vesper"
          />
        </div>
      </div>
      <div class="rounded-2xl border border-[var(--line)] bg-[var(--card)] p-5">
        <h3 class="font-bold">Phone prefix vs E.164</h3>
        <div class="mt-3">
          <Code
            code={`import { getCallingCode, getDialCode } from 'country-kit';

getCallingCode('AI'); // '+1'     ITU-T E.164
getDialCode('AI');    // '+1264'  +1 and Anguilla NPA

// US and Canada stay +1 (no single NPA)`}
            lang="typescript"
            theme="vesper"
          />
        </div>
      </div>
    </div>

    <h2 class="mt-12 text-2xl font-bold">Country shape</h2>
    <div class="mt-4 rounded-2xl border border-[var(--line)] bg-[var(--card)] p-5">
      <Code
        code={`interface Country {
  code: CountryCode;          // 'AD' | 'AE' | … 249 assigned
  name: string;               // ISO English short name
  commonName: string;
  alpha3: string;
  numeric: string;            // UN M49, 3 digits
  callingCode: string;        // ITU-T E.164
  callingCodes: readonly string[];
  dialCode: string;
  region: string | null;
  subregion: string | null;
  independent: boolean;
  tld: string | null;         // '.uk' for GB
  capital: string | null;
  currencies: readonly string[];
  flag: string;               // emoji
  nanpAreaCodes?: readonly string[];
}`}
        lang="typescript"
        theme="vesper"
      />
    </div>

    <h2 class="mt-12 text-2xl font-bold">Breaking changes in 2.0</h2>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-[var(--muted)]">
      <li><code class="font-mono text-sm text-[var(--ink)]">getCallingCode('AI')</code> is <code class="font-mono text-sm text-[var(--ink)]">+1</code>. Use <code class="font-mono text-sm text-[var(--ink)]">getDialCode</code> for <code class="font-mono text-sm text-[var(--ink)]">+1264</code>.</li>
      <li><code class="font-mono text-sm text-[var(--ink)]">isValidCallingCode</code> accepts 1–3 digit E.164 codes, not concatenated NPAs.</li>
      <li>Invalid lookups no longer write to <code class="font-mono text-sm text-[var(--ink)]">console.error</code>.</li>
    </ul>
  </section>
</Layout>
