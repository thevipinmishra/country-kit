---
import Layout from '../layouts/Layout.astro';
import { Code } from 'astro:components';

const rows = [
  ['code, alpha3, name', 'ISO 3166-1 assigned English short names (249 codes)'],
  ['numeric, region, subregion', 'UN M49 (numeric codes are identical to ISO 3166-1 numeric)'],
  ['callingCode', 'ITU-T E.164 country calling codes (1–3 digits)'],
  ['nanpAreaCodes / dialCode', 'NANP NPAs for phone UIs; not E.164 country codes'],
  ['independent', 'ISO 3166 independent-territory flag (195 yes)'],
  ['tld', 'IANA ccTLD. GB is .uk; .gb is unused'],
  ['currencies', 'ISO 4217 alphabetic codes. Empty for Antarctica and Palestine'],
  ['capital', 'Conventional English capital (not an ISO field)'],
  ['flag emoji', 'Unicode UTS #51 regional indicator symbols'],
  ['SVG flags', 'flag-icons 4×3 and 1×1 SVGs (MIT), Wikipedia/Wikimedia originals, pinned at v7.5.0'],
];

const snippetGenerate = `pnpm --filter country-kit generate        # ISO / UN / extras
pnpm --filter country-kit generate:flags  # Wikipedia SVGs from flag-icons`;
---

<Layout title="Data" description="Where country-kit data comes from, what is official, and what we deliberately omit.">
  <section class="container min-w-0 max-w-3xl py-12">
    <h1 class="text-4xl font-semibold tracking-tight">Data sources</h1>
    <p class="mt-3 text-[var(--muted)]">
      country-kit only ships identifiers that map to a published standard. Flags are the exception: ISO 3166 does not define flag artwork, so we use the public Wikipedia/Wikimedia SVGs.
    </p>

    <div class="mt-8 min-w-0 overflow-x-auto rounded-2xl border border-[var(--line)] bg-[var(--card)]">
      <table class="w-full min-w-[28rem] text-left text-sm">
        <thead class="border-b border-[var(--line)] bg-stone-50">
          <tr>
            <th class="px-4 py-3 font-medium">Field</th>
            <th class="px-4 py-3 font-medium">Authority</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(([field, authority]) => (
            <tr class="border-b border-[var(--line)] last:border-0">
              <td class="px-4 py-3 font-mono text-xs">{field}</td>
              <td class="px-4 py-3 text-[var(--muted)]">{authority}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mt-12 text-2xl font-semibold">Calling codes vs dial prefixes</h2>
    <p class="mt-3 text-[var(--muted)]">
      Every NANP member’s E.164 <em>country</em> code is <code class="font-mono text-sm text-[var(--ink)]">+1</code>. Area codes such as Anguilla <code class="font-mono text-sm text-[var(--ink)]">264</code> are national destination codes. country-kit stores them on <code class="font-mono text-sm text-[var(--ink)]">nanpAreaCodes</code> and concatenates the primary NPA onto <code class="font-mono text-sm text-[var(--ink)]">dialCode</code> so a phone picker can still show <code class="font-mono text-sm text-[var(--ink)]">+1264</code>.
    </p>
    <p class="mt-3 text-[var(--muted)]">
      Saint Helena, Ascension and Tristan da Cunha (<code class="font-mono text-sm text-[var(--ink)]">SH</code>) is one ISO entry with two E.164 codes: <code class="font-mono text-sm text-[var(--ink)]">+290</code> and <code class="font-mono text-sm text-[var(--ink)]">+247</code>.
    </p>

    <h2 class="mt-12 text-2xl font-semibold">TLD exceptions</h2>
    <p class="mt-3 text-[var(--muted)]">
      Almost every assigned alpha-2 code maps to <code class="font-mono text-sm text-[var(--ink)]">.</code> plus the lowercase code. The documented IANA exception in this dataset is the United Kingdom: <code class="font-mono text-sm text-[var(--ink)]">GB</code> → <code class="font-mono text-sm text-[var(--ink)]">.uk</code>. Saint Barthélemy is <code class="font-mono text-sm text-[var(--ink)]">.bl</code> and Saint Martin (French) is <code class="font-mono text-sm text-[var(--ink)]">.mf</code>.
    </p>

    <h2 class="mt-12 text-2xl font-semibold">What we deliberately omit</h2>
    <p class="mt-3 text-[var(--muted)]">
      These are useful, but they are other standards or large datasets. They stay out of the default bundle on purpose:
    </p>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-[var(--muted)]">
      <li><strong class="font-medium text-[var(--ink)]">Kosovo (XK)</strong> — user-assigned, not ISO 3166-1 assigned. A future opt-in such as <code class="font-mono text-sm text-[var(--ink)]">{`{ includeUserAssigned: true }`}</code> would fit.</li>
      <li><strong class="font-medium text-[var(--ink)]">ISO 3166-2 subdivisions</strong> — thousands of rows; better as <code class="font-mono text-sm text-[var(--ink)]">country-kit/subdivisions</code>.</li>
      <li><strong class="font-medium text-[var(--ink)]">CLDR localized names</strong> — keep English official + common names in core; add a locale pack later.</li>
      <li><strong class="font-medium text-[var(--ink)]">Timezones, languages, GeoJSON</strong> — IANA tz, ISO 639, and geometry are different products.</li>
      <li><strong class="font-medium text-[var(--ink)]">CI freshness against Debian iso-codes</strong> — a generator check, not a runtime feature.</li>
    </ul>

    <h2 class="mt-12 text-2xl font-semibold">Regenerate</h2>
    <div class="ck-code mt-4">
      <Code code={snippetGenerate} lang="bash" theme="vesper" />
    </div>
    <p class="mt-4 text-[var(--muted)]">
      Sources live in <code class="font-mono text-sm text-[var(--ink)]">packages/country-kit/scripts/sources/</code>. The generator refuses duplicate TLDs, unknown ISO extras, and currency codes that are not three letters.
    </p>
  </section>
</Layout>
