---
import Layout from '../layouts/Layout.astro';
import { Code } from 'astro:components';
import { FLAG_ICONS_VERSION, getAllCountries, getFlagSvgUrl } from 'country-kit';

const flags = getAllCountries({ sortBy: 'commonName' }).map((country) => ({
  code: country.code,
  commonName: country.commonName,
  emoji: country.flag,
  svg: getFlagSvgUrl(country.code) ?? '',
  svgSquare: getFlagSvgUrl(country.code, { ratio: '1x1' }) ?? '',
}));
---

<Layout title="Flags" description="Official Wikipedia SVG flags for every ISO 3166-1 alpha-2 code, plus Unicode emoji.">
  <section class="container py-12">
    <h1 class="text-4xl font-bold tracking-tight">Official SVG flags</h1>
    <p class="mt-3 max-w-2xl text-[var(--muted)]">
      ISO 3166 does not publish flag artwork. country-kit uses the <a class="underline underline-offset-4" href="https://github.com/lipis/flag-icons">flag-icons</a> SVGs (MIT), which are the Wikipedia/Wikimedia drawings of each national flag — the usual public-source set keyed by ISO 3166-1 alpha-2. Pinned at flag-icons@{FLAG_ICONS_VERSION}.
    </p>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-[var(--line)] bg-[var(--card)] p-5">
        <h2 class="font-bold">CDN URL (tiny core bundle)</h2>
        <p class="mt-1 mb-3 text-sm text-[var(--muted)]">Use this in almost every app. The core package only stores the versioned URL pattern.</p>
        <Code code={`import { getFlagSvgUrl } from 'country-kit';

<img src={getFlagSvgUrl('JP')} alt="Japan" />
<img src={getFlagSvgUrl('JP', { ratio: '1x1' })} alt="" />
// jsDelivr · flag-icons@${FLAG_ICONS_VERSION} · flags/4x3/jp.svg`} lang="typescript" theme="vesper" />
      </div>
      <div class="rounded-2xl border border-[var(--line)] bg-[var(--card)] p-5">
        <h2 class="font-bold">Inline SVG (optional entry)</h2>
        <p class="mt-1 mb-3 text-sm text-[var(--muted)]">Import <code class="font-mono text-xs">country-kit/flags</code> only when you need offline markup. It is a separate, larger bundle.</p>
        <Code code={`import { getFlagSvg } from 'country-kit/flags';

element.innerHTML = getFlagSvg('JP');
// 4×3 SVG markup, works offline`} lang="typescript" theme="vesper" />
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <input
        id="flag-q"
        type="search"
        placeholder="Filter flags…"
        class="min-w-[16rem] flex-1 rounded-xl border border-[var(--line)] bg-white px-4 py-2.5 outline-none ring-[var(--accent)] focus:ring-2"
      />
      <label class="flex items-center gap-2 text-sm">
        <input id="flag-ratio" type="checkbox" class="accent-[var(--accent)]" />
        1×1
      </label>
      <label class="flex items-center gap-2 text-sm">
        <input id="flag-emoji" type="checkbox" class="accent-[var(--accent)]" />
        Show emoji
      </label>
    </div>
    <p id="flag-count" class="mt-3 font-mono text-xs text-[var(--muted)]"></p>
    <ul id="flag-grid" class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6"></ul>
  </section>
</Layout>

<script define:vars={{ flags }}>
  const q = document.querySelector('#flag-q');
  const emoji = document.querySelector('#flag-emoji');
  const ratio = document.querySelector('#flag-ratio');
  const grid = document.querySelector('#flag-grid');
  const count = document.querySelector('#flag-count');

  function apply() {
    const query = (q?.value || '').trim().toLowerCase();
    const showEmoji = Boolean(emoji?.checked);
    const square = Boolean(ratio?.checked);
    const matches = flags.filter((flag) => {
      if (!query) return true;
      return (
        flag.commonName.toLowerCase().includes(query) ||
        flag.code.toLowerCase().includes(query)
      );
    });
    if (count) count.textContent = `${matches.length} flags · ${square ? '1×1' : '4×3'} Wikipedia SVG`;
    if (!grid) return;
    grid.innerHTML = matches
      .map(
        (flag) => `<li class="rounded-xl border border-[var(--line)] bg-[var(--card)] p-3">
          <div class="flag-frame ${square ? 'aspect-square' : 'aspect-[4/3]'}"><img src="${square ? flag.svgSquare : flag.svg}" alt="Flag of ${flag.commonName}" loading="lazy" /></div>
          <div class="mt-2 flex items-center justify-between gap-2 text-sm">
            <span class="truncate font-medium">${flag.commonName}</span>
            <span class="font-mono text-xs text-[var(--muted)]">${flag.code}${showEmoji ? ` ${flag.emoji}` : ''}</span>
          </div>
        </li>`,
      )
      .join('');
  }

  q?.addEventListener('input', apply);
  emoji?.addEventListener('change', apply);
  ratio?.addEventListener('change', apply);
  apply();
</script>
