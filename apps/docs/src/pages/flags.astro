---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { FLAG_ICONS_VERSION, getAllCountries, getFlagSvgUrl } from 'country-kit';

const flags = getAllCountries({ sortBy: 'commonName' }).map((country) => ({
  code: country.code,
  commonName: country.commonName,
  emoji: country.flag,
  svg: getFlagSvgUrl(country.code) ?? '',
  svgSquare: getFlagSvgUrl(country.code, { ratio: '1x1' }) ?? '',
}));

const snippetCdn = `import { getFlagSvgUrl } from 'country-kit';

<img src={getFlagSvgUrl('JP')} alt="Flag of Japan" />
<img src={getFlagSvgUrl('JP', { ratio: '1x1' })} alt="" />
// jsDelivr · flag-icons@${FLAG_ICONS_VERSION} · flags/4x3/jp.svg`;

const snippetInline = `import { getFlagSvg } from 'country-kit/flags';

element.innerHTML = getFlagSvg('JP');
// 4x3 SVG markup`;
---

<StarlightPage
  frontmatter={{
    title: 'Flags',
    description:
      'SVG country flags for every ISO 3166-1 alpha-2 code, plus Unicode flag emoji. CDN URLs or inline SVG from country-kit.',
  }}
  headings={[
    { depth: 2, slug: 'cdn-url', text: 'CDN URL' },
    { depth: 2, slug: 'inline-svg', text: 'Inline SVG' },
  ]}
>
  <p class="max-w-2xl text-[var(--muted)]">
    ISO 3166 does not define flag artwork. SVGs come from <a href="https://github.com/lipis/flag-icons">flag-icons</a> (MIT, Wikipedia/Wikimedia drawings), keyed by alpha-2, pinned at {FLAG_ICONS_VERSION}.
  </p>

  <div class="mt-8 grid min-w-0 gap-6 lg:grid-cols-2">
    <div class="min-w-0">
      <h2 id="cdn-url">CDN URL</h2>
      <p>Default. The core package stores the versioned URL pattern.</p>
      <CodeBlock code={snippetCdn} lang="tsx" />
    </div>
    <div class="min-w-0">
      <h2 id="inline-svg">Inline SVG</h2>
      <p>Optional. <code>country-kit/flags</code> is a separate, larger entry.</p>
      <CodeBlock code={snippetInline} lang="typescript" />
    </div>
  </div>

  <div class="not-content mt-8 flex flex-wrap items-end gap-3">
    <div class="min-w-0 flex-1">
      <label for="flag-q" class="ck-label">Filter</label>
      <input
        id="flag-q"
        type="search"
        placeholder="Japan or JP"
        class="ck-field"
      />
    </div>
    <label class="flex min-h-11 items-center gap-2 pb-0.5 text-sm">
      <input id="flag-ratio" type="checkbox" class="size-4 accent-[var(--accent)]" />
      1x1
    </label>
    <label class="flex min-h-11 items-center gap-2 pb-0.5 text-sm">
      <input id="flag-emoji" type="checkbox" class="size-4 accent-[var(--accent)]" />
      Emoji
    </label>
  </div>
  <p id="flag-count" class="tabular mt-3 font-mono text-xs text-[var(--muted)]" role="status"></p>
  <div id="flag-grid" class="not-content mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6"></div>
</StarlightPage>

<script define:vars={{ flags }}>
  const q = document.querySelector('#flag-q');
  const emoji = document.querySelector('#flag-emoji');
  const ratio = document.querySelector('#flag-ratio');
  const grid = document.querySelector('#flag-grid');
  const count = document.querySelector('#flag-count');

  function escapeHtml(value) {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function apply() {
    const query = (q?.value || '').trim().toLowerCase();
    const showEmoji = Boolean(emoji?.checked);
    const square = Boolean(ratio?.checked);
    const matches = flags.filter((flag) => {
      if (!query) return true;
      return (
        flag.commonName.toLowerCase().includes(query) ||
        flag.code.toLowerCase().includes(query)
      );
    });
    if (count) count.textContent = `${matches.length} · ${square ? '1x1' : '4x3'}`;
    if (!grid) return;
    if (!matches.length) {
      grid.innerHTML = `<div class="col-span-full ck-empty">No flags match "${escapeHtml(query)}". Clear the filter to see all 249.</div>`;
      return;
    }
    grid.innerHTML = matches
      .map(
        (flag) => `<div class="ck-panel p-3">
          <div class="flag-frame ${square ? 'aspect-square' : 'aspect-[4/3]'}"><img src="${square ? flag.svgSquare : flag.svg}" alt="Flag of ${escapeHtml(flag.commonName)}" loading="lazy" /></div>
          <div class="mt-2 flex items-center justify-between gap-2 text-sm">
            <span class="truncate font-medium">${escapeHtml(flag.commonName)}</span>
            <span class="font-mono text-xs text-[var(--muted)]">${flag.code}${showEmoji ? ` ${flag.emoji}` : ''}</span>
          </div>
        </div>`,
      )
      .join('');
  }

  q?.addEventListener('input', apply);
  emoji?.addEventListener('change', apply);
  ratio?.addEventListener('change', apply);
  apply();
</script>
